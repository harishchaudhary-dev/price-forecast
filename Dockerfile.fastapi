FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY forecasting/ forecasting/
COPY fastapi_service/ fastapi_service/
RUN useradd -m app
USER app
EXPOSE 8001
HEALTHCHECK CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8001/health')"
CMD ["uvicorn", "fastapi_service.app.main:app", "--host", "0.0.0.0", "--port", "8001", "--workers", "2"]
